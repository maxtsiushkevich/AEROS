FROM golang:1.26-alpine AS builder

WORKDIR /app

COPY auth/go.mod auth/go.sum ./auth/
COPY pkg ./pkg
COPY rbac_config ./rbac_config

WORKDIR /app/auth
RUN go mod download

COPY auth/ ./

RUN CGO_ENABLED=0 GOOS=linux go build -ldflags="-s -w" -o /app/bin/auth ./cmd/auth

FROM alpine:3.20

RUN apk --no-cache add ca-certificates

WORKDIR /app
COPY --from=builder /app/bin/auth ./auth
COPY --from=builder /app/auth/config ./config
COPY --from=builder /app/rbac_config ./rbac_config

ENV RBAC_CONFIG_PATH=/app/rbac_config/config.yaml

EXPOSE 3001
EXPOSE 50051

CMD ["./auth", "--config", "/app/config/config.yaml"]